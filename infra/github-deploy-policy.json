{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LoginNoECR",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EnviarImagens",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-east-2:SUA_CONTA:repository/elo-lab-*"
    },
    {
      "Sid": "ComandoSoNaMaquinaDoLab",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-2:SUA_CONTA:instance/*",
      "Condition": { "StringEquals": { "ssm:resourceTag/Projeto": "elo-lab" } }
    },
    {
      "Sid": "DocumentoDeShell",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-2::document/AWS-RunShellScript"
    },
    {
      "Sid": "AcompanharComando",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}
